# ===== PostgreSQL =====
PG_HOST=127.0.0.1
PG_PORT=5432
PG_SUPERUSER=postgres
# 安装时设定的超级用户密码（仅本机使用，永不提交）
PG_SUPERPASSWORD=change-me
PG_DB=cnc_kb

# ===== 应用库专用账号（可选，V1 复用 superuser） =====
PG_APP_USER=postgres
PG_APP_PASSWORD=change-me

# ===== LLM（DeepSeek，OpenAI 兼容） =====
DEEPSEEK_API_KEY=sk-change-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Embedding / Rerank（硅基流动） =====
SILICONFLOW_API_KEY=sf-change-me
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 应用行为 =====
APP_ENV=dev
LOG_LEVEL=INFO
RERANK_THRESHOLD=0.30
AGENT_MAX_ROUNDS=2
AGENT_TIMEOUT_SEC=30

# ===== W3.9 运行保护 =====
# 同步 /query 处理硬超时；SSE 流整体超时也复用（秒）
QUERY_TIMEOUT_SEC=30
# 每窗口每客户端最大请求数；0=关闭。演示保持 0（避免演示误伤），生产建议 30
RATE_LIMIT_MAX=0
RATE_LIMIT_WINDOW_SEC=60
# 请求体上限（字节）。默认 20MB，Excel 批量导入够用
MAX_BODY_BYTES=20971520
