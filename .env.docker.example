# Docker 部署配置 —— 复制为 .env.docker 并填真值（.env.docker 已被 gitignore）
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
# 说明：与本仓库 app 的 .env（开发用，PG_HOST=127.0.0.1）隔离；此文件既供 compose
#       变量插值，也会注入 backend 容器（env_file:）。示例值仅为占位，无真密钥。

# ---- 数据库（唯一密码来源：db 容器 + backend 共用）----
PG_SUPERUSER=postgres
PG_SUPERPASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
PG_DB=cnc_kb
PG_PORT=5432

# ---- 运行 ----
TZ=Asia/Shanghai
APP_ENV=prod
LOG_LEVEL=INFO
WORKERS=2
RUN_SEEDS=0            # 1=首次启动顺带灌演示报警/账号（幂等；默认只迁移）
BACKEND_PORT=8000      # 宿主机端口
REGISTRY=              # 留空本地构建；上线填如 yourrepo/
TAG=latest

# ---- 远程 AI（真实问答/向量需填）----
DEEPSEEK_API_KEY=sk-REPLACE
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SILICONFLOW_API_KEY=sf-REPLACE
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_THRESHOLD=0.30

# ---- 鉴权 ----
JWT_SECRET=REPLACE_WITH_RANDOM_AT_LEAST_32_CHARS
